# Anthropic API key — the backend calls Claude server-side, never from the browser
ANTHROPIC_API_KEY=sk-ant-...

# Model to use for SQL generation
ANTHROPIC_MODEL=claude-sonnet-4-6

# Connection string for a READ-ONLY database role.
# Never point this at a role with write/DDL privileges.
DATABASE_URL=sqlite:///./demo.db

# Hard ceiling enforced server-side regardless of what the model writes
MAX_ROWS_RETURNED=500

# Query timeout in seconds (Postgres/MySQL — SQLite ignores this)
QUERY_TIMEOUT_SECONDS=10

# Where the audit log is written (append-only JSONL for this scaffold;
# swap for a real table/log pipeline in production)
AUDIT_LOG_PATH=./audit_log.jsonl
